{
  "name": "@pubb/sdk",
  "version": "0.2.0",
  "description": "JavaScript and TypeScript SDK for Pubb realtime messaging",
  "license": "MIT",
  "author": "Pubb",
  "homepage": "https://pubb.io",
  "keywords": [
    "realtime",
    "websocket",
    "pubsub",
    "pubb",
    "messaging"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/pubb.min.global.js",
  "jsdelivr": "./dist/pubb.min.global.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    },
    "./browser": "./dist/pubb.min.global.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "npm run typecheck && npm test",
    "prepack": "npm run check"
  },
  "devDependencies": {
    "@types/node": "20.19.30",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pubbio/sdk-js.git"
  },
  "bugs": {
    "url": "https://github.com/pubbio/sdk-js/issues"
  }
}
